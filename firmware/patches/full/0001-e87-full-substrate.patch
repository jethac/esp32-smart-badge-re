--- a/SDK/apps/watch/app_main.c
+++ b/SDK/apps/watch/app_main.c
@@ -1 +1,71 @@
+#include "app_config.h"
+
+#ifdef CONFIG_BOARD_E87_1542_FULL_H
+#define E87_FULL_APP_MAIN_BEGIN 1
+
+#include "system/includes.h"
+#include "app_main.h"
+#include "e87/e87_app.h"
+
+#include <string.h>
+
+#define TASK_PRIO_BASE 20
+
+const struct task_info task_info_table[] = {
+    {"app_core", 20, 0, 768, 768},
+    {0, 0},
+};
+
+APP_VAR app_var;
+
+int eSystemConfirmStopStatus(void)
+{
+    return 0;
+}
+
+int *__errno(void)
+{
+    static int error;
+
+    return &error;
+}
+
+void app_var_init(void)
+{
+    memset(&app_var, 0, sizeof(app_var));
+}
+
+extern void board_init(void);
+
+static void e87_full_fail_closed(void)
+{
+    for (;;) {
+        wdt_clear();
+        os_time_dly(1);
+    }
+}
+
+static void e87_full_app_task(void *private_data)
+{
+    (void)private_data;
+    app_var_init();
+    board_init();
+    wdt_init(WDT_APP_RUN_TIME);
+    if (!e87_app_start()) {
+        e87_full_fail_closed();
+    }
+    e87_app_dispatch_forever();
+}
+
+void app_main(void)
+{
+    task_create(e87_full_app_task, NULL, "app_core");
+    os_start();
+    for (;;) {
+        asm("idle");
+    }
+}
+
+#define E87_FULL_APP_MAIN_END 1
+#else
 #ifdef SUPPORT_MS_EXTENSIONS
@@ -799,2 +869,2 @@ void app_main()
 }
-
+#endif
