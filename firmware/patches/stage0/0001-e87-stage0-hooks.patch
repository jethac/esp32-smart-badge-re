diff --git a/SDK/apps/watch/app_main.c b/SDK/apps/watch/app_main.c
index eb881b5..11a1c66 100644
--- a/SDK/apps/watch/app_main.c
+++ b/SDK/apps/watch/app_main.c
@@ -1 +1,68 @@
+#include "app_config.h"
+
+#ifdef CONFIG_BOARD_E87_1542_STAGE0_H
+#define E87_STAGE0_APP_MAIN_BEGIN 1
+
+#include "system/includes.h"
+#include "app_main.h"
+#include "e87/e87_stage0_app.h"
+
+#include <string.h>
+
+#define TASK_PRIO_BASE 20
+
+const struct task_info task_info_table[] = {
+    {"app_core", 0 + TASK_PRIO_BASE, 0, 768, 768},
+    {"btctrler", 4 + TASK_PRIO_BASE, 0, 512, 512},
+    {"btstack", 3 + TASK_PRIO_BASE, 0, 768, 256},
+    {0, 0},
+};
+
+APP_VAR app_var;
+
+int *__errno(void)
+{
+    static int error;
+
+    return &error;
+}
+
+void app_var_init(void)
+{
+    memset(&app_var, 0, sizeof(app_var));
+}
+
+extern void board_init(void);
+
+static void e87_stage0_fail_closed(void)
+{
+    for (;;) {
+        wdt_clear();
+        os_time_dly(1);
+    }
+}
+
+static void e87_stage0_app_task(void *private_data)
+{
+    (void)private_data;
+    app_var_init();
+    board_init();
+    wdt_init(WDT_APP_RUN_TIME);
+    if (!e87_stage0_app_start()) {
+        e87_stage0_fail_closed();
+    }
+    e87_stage0_app_dispatch_forever();
+}
+
+void app_main(void)
+{
+    task_create(e87_stage0_app_task, NULL, "app_core");
+    os_start();
+    for (;;) {
+        asm("idle");
+    }
+}
+
+#define E87_STAGE0_APP_MAIN_END 1
+#else
 #ifdef SUPPORT_MS_EXTENSIONS
@@ -799,2 +866,3 @@ void app_main()
 }
-
+
+#endif
