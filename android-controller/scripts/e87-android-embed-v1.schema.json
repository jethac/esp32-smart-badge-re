{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "buildId": {"pattern": "^[0-9A-F]{32}$", "type": "string"},
    "chip": {"const": "AC707N"},
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "filename": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "type": "string"},
          "length": {"minimum": 1, "type": "integer"},
          "role": {"enum": ["appBin", "jlIsdFw", "updateUfw", "qix", "manifest", "sha256Sums"]},
          "sha256": {"pattern": "^[0-9A-F]{64}$", "type": "string"}
        },
        "required": ["filename", "length", "role", "sha256"],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "labEligible": {"const": true},
    "layout": {"const": "SINGLE_BANK"},
    "profile": {"const": "E87-JD9855-R1"},
    "qixVersion": {"const": "11.1.0.3"},
    "releaseEligible": {"type": "boolean"},
    "releaseRoot": {"pattern": "^E87-JD9855-R1/[0-9]+\\.[0-9]+\\.[0-9]+/[0-9A-F]{32}$", "type": "string"},
    "schemaId": {"const": "e87-android-embed-v1"},
    "schemaVersion": {"const": 1},
    "semver": {"pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string"}
  },
  "required": ["buildId", "chip", "files", "labEligible", "layout", "profile", "qixVersion", "releaseEligible", "releaseRoot", "schemaId", "schemaVersion", "semver"],
  "title": "E87 Android firmware embedding handoff v1",
  "type": "object"
}
