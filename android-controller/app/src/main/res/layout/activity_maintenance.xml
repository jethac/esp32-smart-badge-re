<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/maintenance_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/maintenance_title"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/artifact_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/artifact_not_packaged" />

        <TextView
            android:id="@+id/artifact_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/receive_mode_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/stock_receiving_warning" />

        <CheckBox
            android:id="@+id/receive_mode_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="false"
            android:enabled="false"
            android:text="@string/confirm_stock_receiving" />

        <Button
            android:id="@+id/start_transition_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/start_stock_transition" />

        <TextView
            android:id="@+id/candidate_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/stock_candidates"
            android:visibility="gone" />

        <ListView
            android:id="@+id/candidate_list"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:choiceMode="singleChoice"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/transition_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/transition_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/transition_idle" />

        <Button
            android:id="@+id/cancel_transition_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/cancel_transition" />

        <TextView
            android:id="@+id/rewrite_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rewrite_custom_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Title" />

        <TextView
            android:id="@+id/rewrite_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rewrite_custom_unavailable" />

        <Button
            android:id="@+id/rewrite_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/rewrite_custom_firmware" />
    </LinearLayout>
</ScrollView>
